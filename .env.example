# ---------------------------------------------------------------------------
# Copy to .env and adjust.  NEVER commit a real .env — it is git-ignored.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- HTTP ------------------------------------------------------------------
PORT=3000
# Public base URL of this API. Used to build the <script> embed snippet.
PUBLIC_BASE_URL=http://localhost:3000
# Comma-separated origins allowed to call the *authenticated* admin/dashboard
# API. The public widget endpoints are intentionally open to every origin.
ADMIN_CORS_ORIGINS=http://localhost:3000,http://localhost:5500
# Number of reverse proxies in front of the app (Express `trust proxy`).
# 0 = no proxy. Set to 1 behind a single load balancer, otherwise client IPs
# can be spoofed through X-Forwarded-For.
TRUST_PROXY_HOPS=0

# --- Database --------------------------------------------------------------
DATABASE_URL=postgres://flyrank:flyrank@localhost:55432/flyrank
# Separate database used by `npm test`. The suite TRUNCATEs it between tests.
TEST_DATABASE_URL=postgres://flyrank:flyrank@localhost:55432/flyrank_test

# --- Auth ------------------------------------------------------------------
# Replace with 32+ random bytes:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL_SECONDS=86400

# --- Public submission limits ---------------------------------------------
SUBMISSION_BODY_LIMIT_BYTES=16384
RATE_LIMIT_IP_WINDOW_SECONDS=60
RATE_LIMIT_IP_MAX=10
RATE_LIMIT_WIDGET_WINDOW_SECONDS=60
RATE_LIMIT_WIDGET_MAX=60
# A form filled faster than this is treated as a bot (0 disables the check).
SPAM_MIN_FILL_MS=1200

# --- Geo enrichment --------------------------------------------------------
# Ordered fallback chain. Providers: ip-api, ipapi-co, mock-a, mock-b.
# Use the mock providers for deterministic fallback proofs.
GEO_PROVIDERS=ip-api,ipapi-co
GEO_TIMEOUT_MS=1500
# Force a provider "down" without touching code (comma-separated names).
GEO_FORCE_DOWN=

# --- Background jobs -------------------------------------------------------
JOB_POLL_INTERVAL_MS=1000
JOB_MAX_ATTEMPTS=5
JOB_BATCH_SIZE=10
# Run the job worker inside the API process. Set to false when running
# `npm run start:worker` as a separate container/process.
RUN_WORKER_IN_PROCESS=true

# --- Email side effect -----------------------------------------------------
# log  = write the message to the log (default, $0, no service needed)
# smtp = real SMTP, e.g. Mailpit at localhost:1025
# fail = always throw; used to prove a failing side effect cannot break a
#        submission (acceptance probe 5). Never use outside a demo.
EMAIL_TRANSPORT=log
EMAIL_FROM="FlyRank Widgets <no-reply@flyrank.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
